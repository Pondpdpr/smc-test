# Used by `npm run build` + `npm run preview` (Vite mode: production - preview
# defaults to it too). Calls go straight to the backend rather than through
# Vite's proxy, which makes them cross-origin - the backend's CORS_ORIGIN
# must include this frontend's origin (http://localhost:4173, see
# backend/.env.example). Change to the deployed backend's URL for a real
# separate-host deployment.
VITE_API_URL=http://localhost:3000

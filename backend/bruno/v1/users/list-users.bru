meta {
  name: list-users
  type: http
  seq: 2
}

get {
  url: {{url}}/v1/users?includes=posts,posts.comments
  body: none
  auth: inherit
}

params:query {
  includes: posts,posts.comments
  ~sort: createdAt
  ~pagination[page]: 1
  ~pagination[perPage]: 1
  ~filter[firstName]: superadmin
  ~filter[lastName]: superadmin
  ~filter[email]: superadmin@example.com
  ~filter[search]: superadmin
  ~filter[status]: ACTIVE
  ~countFilter[firstName]: superadmin
  ~countFilter[lastName]: superadmin
  ~countFilter[email]: superadmin@example.com
  ~countFilter[search]: superadmin
  ~countFilter[status]: ACTIVE
}

body:json {
  {
    "email": "tet@example.com",
    "password": "password"
  }
}

{
  "name": "kysely-template",
  "version": "0.0.1",
  "description": "",
  "author": "Khunakorn Johnson",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": "24.13.0",
    "npm": "11.6.2"
  },
  "scripts": {
    "cmd": "./cmd.sh",
    "start": "node dist/main",
    "start:worker": "node dist/worker",
    "start:cron": "node dist/cron",
    "start:repl": "node dist/repl",
    "start:cli": "NODE_ENV=cli node dist/cli",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "vitest run",
    "cli": "./cmd.sh cli",
    "dev": "concurrently -k --handle-input --kill-signal=SIGINT -n app,worker -c blue,green 'npm run dev:app' 'npm run dev:worker'",
    "dev:app": "npx nest start --watch",
    "dev:worker": "nodemon --exec 'node -r tsconfig-paths/register -r @swc-node/register ./src/worker.ts'",
    "dev:cron": "nodemon --exec 'ts-node -r tsconfig-paths/register -r @swc-node/register ./src/cron.ts'",
    "debug": "nest start --debug --watch",
    "debug:worker": "nodemon --exec 'node --inspect=0.0.0.0:9229 ./dist/worker.js'",
    "dev:email": "email dev --dir ./src/infra/global/email/template --port 3001",
    "repl": "./cmd.sh repl",
    "lang": "npx typesafe-i18n --no-watch && node -e \"require('fs').unlinkSync('./src/infra/i18n/i18n-util.async.ts')\"",
    "typesafe-i18n": "typesafe-i18n"
  },
  "dependencies": {
